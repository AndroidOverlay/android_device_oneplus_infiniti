# Bluetooth
bluetooth.device.default_name=OnePlus 15

# Display
vendor.display.oplus_adfr=1
vendor.display.oplus_adfr.min_fps=1
vendor.display.oplus_adfr.supported_rates=60,90,120
vendor.display.enable_spr_bypass=0
vendor.display.enable_spr=1

# Graphics
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_idle_timer_ms=80
ro.surface_flinger.set_touch_timer_ms=200

# USB
vendor.usb.product_string=OnePlus 15
